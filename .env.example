# ==============================================================================
# ARQUIVO DE EXEMPLO DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo para .env e preencha com suas próprias credenciais:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Chaves de LLM (Providers)
# ------------------------------------------------------------------------------
# Google Gemini API: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# Groq API: https://console.groq.com/
GROQ_API_KEY=sua_chave_groq_aqui

# NVIDIA NIM API (Opcional): https://build.nvidia.com/
NVIDIA_API_KEY=sua_chave_nvidia_aqui

# Typesafe / Juiz (Opcional): https://typesafe.ai/
TYPESAFE_API_KEY=sua_chave_typesafe_aqui

# ------------------------------------------------------------------------------
# Bancos de Dados
# ------------------------------------------------------------------------------
# PostgreSQL (Ex: Neon, Aiven, Supabase ou local)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco?sslmode=require

# MongoDB (Local ou MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017

# ------------------------------------------------------------------------------
# Vetorização e RAG (Qdrant)
# ------------------------------------------------------------------------------
# Qdrant URL (Local ou Qdrant Cloud)
QDRANT_URL=https://seu-cluster.qdrant.io
QDRANT_API_KEY=sua_api_key_qdrant_aqui

# Caminho para o PDF de FAQ utilizado na ingestão do RAG
FAQ_PDF_PATH=FAQ_assessor_v1.1.pdf

# ------------------------------------------------------------------------------
# Google Calendar & OAuth (Desktop Flow)
# ------------------------------------------------------------------------------
# Caminho para o arquivo de credenciais do Google Cloud Console
GOOGLE_OAUTH_CREDENTIALS=gcp-oauth.keys.json

# Servidor MCP do Google Calendar
GOOGLE_CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1

# Token opcional caso configurado manualmente
# GOOGLE_CALENDAR_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Observabilidade e Rastreamento (LangSmith)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=sua_chave_langsmith_aqui
LANGSMITH_PROJECT=assessor-aula
